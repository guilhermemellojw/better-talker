# ===== Firebase (opcional — só-metadados, BYOD) =====
# Copie este arquivo para .env.local e preencha com os valores
# do seu projeto Firebase (Firebase Console > Configurações do projeto > Seus apps > Web).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ===== Gemini API Key (opcional) =====
# O usuário também pode digitar a chave nas configurações do app.
VITE_GEMINI_API_KEY=

# ===== Provedor do Copilot (Fase 4 — opcional) =====
# VITE_LLM_PROVIDER=gemini (padrão) ou qwen. Qwen exige endpoint remoto
# compatível com Chat Completions; sem endpoint, o provider fica indisponível
# (não há execução local no web). Nenhum segredo vai para o código.
VITE_LLM_PROVIDER=
VITE_QWEN_ENDPOINT=
VITE_QWEN_MODEL=
VITE_QWEN_API_KEY=