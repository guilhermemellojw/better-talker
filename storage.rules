rules_version = '2';
// Better Talker — 5.4: backup de imagens por usuário.
//
// Estrutura: users/{uid}/images/{noteId}/{imageId}.{ext}
// - só o dono lê/escreve;
// - só imagem e no máximo 10 MB por objeto;
// - nada é público;
// - qualquer outro caminho é negado (fail-closed).
service firebase.storage {
  match /b/{bucket}/o {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    match /users/{uid}/images/{allPaths=**} {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && request.resource.size <= 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if isOwner(uid);
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
