rules_version = '2';
// Better Talker — regras do Firestore (v2, escopo do MVP de sync).
//
// Estrutura por usuário (tudo em users/{uid}/):
//   notes, folders, sections, subPoints, attachments, outlines, tombstones
//   _sync/clock (heartbeat de relógio)
//
// Regras:
// - cada usuário só acessa a própria árvore;
// - writes validam campos/tipos essenciais e limites de tamanho;
// - `schemaVersion` é opcional nesta versão (o cliente atual ainda não envia);
//   quando presente, precisa ser 1;
// - coleções desconhecidas são negadas (fail-closed).
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function onlyKnownTombstoneTypes() {
      return request.resource.data.type in [
        'note', 'folder', 'attachment', 'outline', 'section', 'subPoint'
      ];
    }

    match /users/{uid} {
      allow read, write: if false;

      // ----- notas -----
      match /notes/{id} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && request.resource.data.title is string
          && request.resource.data.mdText is string
          && request.resource.data.mdText.size() < 900000
          && request.resource.data.richHtml is string
          && request.resource.data.richHtml.size() < 900000
          && request.resource.data.pinned is bool
          && request.resource.data.trashed is bool
          && request.resource.data.colorArgb is int
          && request.resource.data.createdAt is int
          && request.resource.data.updatedAt is int
          && (
            !('folderId' in request.resource.data) ||
            request.resource.data.folderId is string
          )
          && (
            !('schemaVersion' in request.resource.data) ||
            request.resource.data.schemaVersion == 1
          );
        allow delete: if isOwner(uid);
      }

      // ----- pastas -----
      match /folders/{id} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && request.resource.data.name is string
          && request.resource.data.colorArgb is int
          && request.resource.data.createdAt is int;
        allow delete: if isOwner(uid);
      }

      // ----- seções -----
      match /sections/{id} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && request.resource.data.noteId is string
          && request.resource.data.order is int
          && request.resource.data.role is string
          && request.resource.data.title is string
          && request.resource.data.minutes is int
          && request.resource.data.contentHtml is string
          && request.resource.data.contentHtml.size() < 900000
          && request.resource.data.createdAt is int
          && request.resource.data.updatedAt is int
          && (
            !('schemaVersion' in request.resource.data) ||
            request.resource.data.schemaVersion == 1
          );
        allow delete: if isOwner(uid);
      }

      // ----- subpontos -----
      match /subPoints/{id} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && request.resource.data.sectionId is string
          && request.resource.data.order is int
          && request.resource.data.outlineText is string
          && request.resource.data.developedHtml is string
          && request.resource.data.developedHtml.size() < 900000
          && request.resource.data.createdAt is int
          && request.resource.data.updatedAt is int
          && (
            !('schemaVersion' in request.resource.data) ||
            request.resource.data.schemaVersion == 1
          );
        allow delete: if isOwner(uid);
      }

      // ----- anexos (só metadados; binário nunca sobe) -----
      match /attachments/{id} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && request.resource.data.fileName is string
          && request.resource.data.kind is string
          && request.resource.data.sizeBytes is int
          && request.resource.data.addedAt is int
          && (
            !('noteId' in request.resource.data) ||
            request.resource.data.noteId is string
          )
          && (
            !('baseSlot' in request.resource.data) ||
            request.resource.data.baseSlot is string
          )
          && (
            !('sourceUrl' in request.resource.data) ||
            request.resource.data.sourceUrl is string
          )
          && (
            !('indexed' in request.resource.data) ||
            request.resource.data.indexed is bool
          );
        allow delete: if isOwner(uid);
      }

      // ----- outlines / S-34 -----
      match /outlines/{id} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && request.resource.data.noteId is string
          && request.resource.data.fileName is string
          && request.resource.data.title is string
          && request.resource.data.sectionsJson is string
          && request.resource.data.sectionsJson.size() < 900000
          && request.resource.data.refsJson is string
          && request.resource.data.refsJson.size() < 900000
          && request.resource.data.createdAt is int
          && request.resource.data.updatedAt is int
          && (
            !('schemaVersion' in request.resource.data) ||
            request.resource.data.schemaVersion == 1
          );
        allow delete: if isOwner(uid);
      }

      // ----- S-34 (estrutura flat; sem binário) -----
      match /s34Outlines/{id} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && request.resource.data.sourceAttachmentId is string
          && request.resource.data.symbol is string
          && request.resource.data.title is string
          && request.resource.data.headerLinesJson is string
          && request.resource.data.headerLinesJson.size() < 900000
          && request.resource.data.createdAt is int
          && request.resource.data.updatedAt is int
          && request.resource.data.parserVersion is int
          && (
            !('objective' in request.resource.data) ||
            request.resource.data.objective == null ||
            request.resource.data.objective is string
          );
        allow delete: if isOwner(uid);
      }

      match /s34Sections/{id} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && request.resource.data.outlineId is string
          && request.resource.data.order is int
          && request.resource.data.title is string
          && request.resource.data.content is string
          && request.resource.data.content.size() < 900000
          && request.resource.data.sourceLine is int
          && (
            !('minutes' in request.resource.data) ||
            request.resource.data.minutes == null ||
            request.resource.data.minutes is int
          );
        allow delete: if isOwner(uid);
      }

      match /s34Subsections/{id} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && request.resource.data.sectionId is string
          && request.resource.data.order is int
          && request.resource.data.content is string
          && request.resource.data.content.size() < 900000
          && request.resource.data.sourceLine is int;
        allow delete: if isOwner(uid);
      }

      match /s34References/{id} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && request.resource.data.outlineId is string
          && request.resource.data.order is int
          && request.resource.data.type is string
          && request.resource.data.rawText is string
          && request.resource.data.rawText.size() < 4000
          && request.resource.data.normalizedReference is string
          && request.resource.data.sourceLine is int
          && (
            !('sectionId' in request.resource.data) ||
            request.resource.data.sectionId == null ||
            request.resource.data.sectionId is string
          )
          && (
            !('subsectionId' in request.resource.data) ||
            request.resource.data.subsectionId == null ||
            request.resource.data.subsectionId is string
          )
          && (
            !('chapter' in request.resource.data) ||
            request.resource.data.chapter == null ||
            request.resource.data.chapter is int
          )
          && (
            !('verse' in request.resource.data) ||
            request.resource.data.verse == null ||
            request.resource.data.verse is int
          );
        allow delete: if isOwner(uid);
      }

      // ----- tombstones -----
      match /tombstones/{id} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && onlyKnownTombstoneTypes()
          && request.resource.data.deletedAt is int;
        allow delete: if isOwner(uid);
      }

      // ----- heartbeat de relógio -----
      match /_sync/{doc} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && request.resource.data.keys().hasOnly(['at']);
        allow delete: if isOwner(uid);
      }

      // Qualquer outra coleção/subcoleção: negada.
      match /{document=**} {
        allow read, write: if false;
      }
    }
  }
}
